--
--  Reads the game controller for a few seconds (make pad)
project Padprobe is
   for Source_Dirs use ("src", "tests");
   for Source_Files use ("gamepad.ads", "gamepad.adb", "wheel.ads", "wheel.adb", "padprobe.adb");
   for Object_Dir use "obj/pad";
   for Exec_Dir use "bin";
   for Main use ("padprobe.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatyN", "-gnatwU");
   end Compiler;
end Padprobe;
