--  AdaRace: the headless physics tests (no GTK needed)
project Simtest is
   for Source_Dirs use ("src", "tests");
   for Source_Files use
     ("track.ads", "track.adb", "vehicle.ads", "vehicle.adb",
      "session.ads", "session.adb", "telemetry.ads", "telemetry.adb", "school.ads", "school.adb", "codriver.ads", "codriver.adb", "rally.ads", "rally.adb", "championship.ads", "championship.adb", "simtest.adb", "trace.adb", "catch.adb");
   for Object_Dir use "obj/test";
   for Exec_Dir use "bin";
   for Main use ("simtest.adb", "trace.adb", "catch.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnat2012", "-gnatwa", "-gnatyN", "-gnatwU");
   end Compiler;
end Simtest;
