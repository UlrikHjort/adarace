project Wheelprobe is
   for Source_Dirs use ("src", "tests");
   for Source_Files use ("wheel.ads", "wheel.adb", "wheelprobe.adb");
   for Object_Dir use "obj/probe";
   for Exec_Dir use "bin";
   for Main use ("wheelprobe.adb");
end Wheelprobe;
